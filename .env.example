# Application
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=replace-with-random-value
MCP_CONTEXT_SECRET=replace-with-another-random-value
WORKERS_ENABLED=true

# PostgreSQL through the local SSH tunnel
DATABASE_URL=postgresql+psycopg://crossborder_cs_app:CHANGE_ME@127.0.0.1:55432/crossborder_cs
TEST_DATABASE_URL=postgresql+psycopg://crossborder_cs_app:CHANGE_ME@127.0.0.1:55432/crossborder_cs_test
MCP_DATABASE_URL=postgresql+psycopg://crossborder_cs_ro:CHANGE_ME@127.0.0.1:55432/crossborder_cs

# Seed / local demo credentials
SEED_PASSWORD=DevPass#2026
TEST_CHANNEL_SECRET=local-channel-secret-change-me

# Deterministic local adapters: fake | openai | deepl | hash | lexical | bge_m3 | bge_reranker
LLM_PROVIDER=fake
TRANSLATION_PROVIDER=fake
EMBEDDING_PROVIDER=hash
RERANKER_PROVIDER=lexical

# Agent tool budget (raise for high-latency remote databases)
MCP_TOOL_TIMEOUT_SECONDS=10
AGENT_TOTAL_TIMEOUT_SECONDS=60
AGENT_MAX_STEPS=6

# Optional real adapters (leave empty to keep them disabled)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPL_API_KEY=

# Per-store enablement: comma-separated store UUIDs; empty means every real call is disabled
INTEGRATION_ENABLED_STORE_IDS=

# Amazon SP-API (orders read only)
AMAZON_SP_API_ENABLED=false
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=us-east-1
AMAZON_ENDPOINT=https://sellingpartnerapi-fe.amazon.com
AMAZON_LWA_ENDPOINT=https://api.amazon.com/auth/o2/token
AMAZON_MARKETPLACE_IDS=A1VC38T7YXB528
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 17TRACK logistics
TRACK17_ENABLED=false
TRACK17_API_KEY=
TRACK17_BASE_URL=https://api.17track.net/track/v2.2

# ERP inventory gateway
ERP_ENABLED=false
ERP_BASE_URL=
ERP_API_KEY=

# Pilot customer-service channel
CHANNEL_ENABLED=false
CHANNEL_BASE_URL=
CHANNEL_API_KEY=
CHANNEL_TIMEOUT_SECONDS=10

# Translation gateway
TRANSLATION_ENABLED=false
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=

# Local attachment object storage
ATTACHMENT_ROOT=data/attachments
ATTACHMENT_MAX_BYTES=10485760

# Milvus vector index (falls back to the in-process fake index when disabled)
MILVUS_ENABLED=false
MILVUS_URI=
MILVUS_TOKEN=

# On-demand OCR (fake | http)
OCR_PROVIDER=fake
OCR_BASE_URL=
OCR_API_KEY=

# Remote PostgreSQL bootstrap / tunnel metadata
REMOTE_SSH_HOST=36.139.119.132
REMOTE_SSH_PORT=22
REMOTE_SSH_USER=root
REMOTE_PG_PORT=55432
REMOTE_SSH_KEY=C:/Users/44332/.ssh/crossborder_cs_ed25519